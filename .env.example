# Copy to .env and fill in
#
# Prefer keeping real keys OUT of .env: put them in doctor_dictation/secrets.json
# (already gitignored) instead. Precedence per secret: an environment variable
# -- if PRESENT, even when empty -- wins, else doctor_dictation/secrets.json, else "".
# Point to a different secrets file with SECRETS_FILE=/path/to/secrets.json.
# Note: Windows cannot express POSIX 0600 on that file; restrict it with ACLs.
# Example doctor_dictation/secrets.json: {"OPENAI_API_KEY": "sk-...", "DEEPSEEK_API_KEY": "..."}
# Default structuring LLM (prescription JSON): OpenAI. DeepSeek kept as option.
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
# Vision-capable model for the letterhead template tool. Blank reuses LLM_MODEL.
LLM_VISION_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=   (paste key here; also used for cloud STT default)
# DEEPSEEK_API_KEY=   (opt-in: uncomment to set via env; prefer doctor_dictation/secrets.json)
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Deterministic LLM decode: temperature 0 + fixed seed (retried without seed if endpoint rejects it)
DEEPSEEK_SEED=7
# --- STT (cloud-first) ---
# Cloud (OpenAI Whisper API) is the default; the recorded audio is sent to OpenAI
# and is NOT saved by the app. The only STT knobs are STT_ENGINE and WHISPER_MODEL
# (the local fallback model) — there is no in-app model picker.
# STT engine: auto (cloud-first, default) | openai | faster-whisper | onnx (Snapdragon, see doctor_dictation/requirements-onnx.txt)
STT_ENGINE=auto
# local fallback model ONLY: small.en (default; turbo avoided — too slow on CPU)
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
PORT=8000

# Largest audio upload /api/transcribe accepts, in bytes (default 10 MiB). Over this -> HTTP 413.
# MAX_AUDIO_BYTES=10485760

# STT chain, tried in order: openai, faster-whisper, onnx, browser. Blank = derived from STT_ENGINE.
# STT_CHAIN=openai,faster-whisper
# Load tests and demos only: lets STT_CHAIN=stub run the fake provider (STUB_TRANSCRIPT, STUB_DELAY_MS).
# ALLOW_STUB_PROVIDERS=1

# --- ACC2 accuracy flags (both OFF by default; enable only if the benchmark shows a net gain) ---
# STT_USE_HINTS=1      send the doctor's most-used medicines + common lexicon names as a Whisper vocabulary prompt
# STT_HINT_LIMIT=70    max names in that prompt (~70 fit Whisper's 224-token window)
# STT_TRIM_SILENCE=1   cut long pauses (keeps ~300 ms padding) with ffmpeg before upload; skipped if ffmpeg is missing
# FFMPEG_BIN=ffmpeg    optional path to the ffmpeg binary

# --- Multi-clinic (off by default) ---
# MULTI_CLINIC=1 gives each clinic its own folder under DATA_DIR (directory.db + clinics/<slug>/).
# DB_PATH is ignored in that mode. Create clinics with: python -m doctor_dictation.admin create-clinic --slug rao --name "Rao Clinic"
MULTI_CLINIC=0
# DATA_DIR=/var/lib/doctor-dictation
# Required when MULTI_CLINIC=1: signs session cookies. At least 32 random characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SESSION_SECRET=
# Local development only: lets the app start without SESSION_SECRET (sessions are then forgeable).
# DEV_INSECURE_SESSION_SECRET=1
# Demo only: lets `python -m doctor_dictation.admin seed-demo` create two FAKE clinics whose doctors have published
# passwords. It refuses a data folder that already has clinics. Never set this outside a demo.
# DEMO_MODE=1
