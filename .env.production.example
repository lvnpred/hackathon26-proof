# Copy to .env.production and edit. Never commit it (.gitignore blocks .env.*). Change every REPLACE_ME.
SITE_ADDRESS=clinic.example.com
# Required: the app refuses to start without it. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=REPLACE_ME_generated_secret
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
LLM_VISION_MODEL=
OPENAI_API_KEY=REPLACE_ME_your_openai_key
STT_ENGINE=auto
# Groq hosted Whisper (about a third of the OpenAI price): set STT_ENGINE=groq and the key
# GROQ_API_KEY=REPLACE_ME_your_groq_key
# Or AssemblyAI (STT_ENGINE=assemblyai; ASSEMBLYAI_MEDICAL=1 for Medical Mode)
# ASSEMBLYAI_API_KEY=REPLACE_ME_your_assemblyai_key
# Or Meta Muse (STT_ENGINE=muse; MUSE_LANGUAGE_BIAS=English,Hindi for mixed dictation)
# META_API_KEY=REPLACE_ME_your_meta_model_api_key
MAX_AUDIO_BYTES=10485760
TEMPLATE_MAX_IMAGE_BYTES=8388608
TEMPLATE_UPLOADS_PER_DAY=10
UPLOAD_LIMIT=11MiB
# Medicine-name hints and silence trimming (ffmpeg is in the image). Set 0 to turn either off.
STT_USE_HINTS=1
STT_TRIM_SILENCE=1
# One per CPU core; each worker runs its own Chromium (about 300 MiB)
WEB_CONCURRENCY=2
